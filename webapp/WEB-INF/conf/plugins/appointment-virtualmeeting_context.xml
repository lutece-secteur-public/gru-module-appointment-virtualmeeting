<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:context="http://www.springframework.org/schema/context"
    xmlns:tx="http://www.springframework.org/schema/tx" xmlns:jdbc="http://www.springframework.org/schema/jdbc"
    xmlns:p="http://www.springframework.org/schema/p"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
       http://www.springframework.org/schema/context
       http://www.springframework.org/schema/context/spring-context-3.0.xsd
       http://www.springframework.org/schema/tx
       http://www.springframework.org/schema/tx/spring-tx-3.0.xsd">
       
      <!-- ======================== DAOs ======================== -->

      <bean id="appointment-virtualmeeting.addVirtualMeetingTaskConfigDAO"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.business.AddVirtualMeetingTaskConfigDAO" />

      <bean id="appointment-virtualmeeting.virtualMeetingDAO"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.business.VirtualMeetingDAO" />

      <bean id="appointment-virtualmeeting.virtualMeetingTaskInformationDAO"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.business.VirtualMeetingTaskInformationDAO" />

      <!-- ======================== Services ======================== -->

      <bean id="appointment-virtualmeeting.virtualMeetingService"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.service.VirtualMeetingService" />
            
      <bean id="appointment-virtualmeeting.appointmentAddonService"                                                                                                                                                                                                             
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.service.VirtualMeetingAppointmentAddonService" />

      <bean id="appointment-virtualmeeting.entryIdsCacheService" 
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.service.VirtualMeetingEntryIdsCacheService" />


      <bean id="appointment-virtualmeeting.addVirtualMeetingTaskService"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.service.AddVirtualMeetingTaskService"
            p:taskConfigDAO-ref="appointment-virtualmeeting.addVirtualMeetingTaskConfigDAO" />

      <!-- ======================== Config Beans ======================== -->

      <bean id="appointment-virtualmeeting.addVirtualMeetingTaskConfig"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.business.AddVirtualMeetingTaskConfig"
            scope="prototype" />

      <!-- ======================== Task Types ======================== -->

      <bean id="appointment-virtualmeeting.addVirtualMeetingTaskType"
            class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
            p:key="addVirtualMeetingTask"
            p:titleI18nKey="module.appointment.virtualmeeting.task.addVirtualMeeting.title"
            p:beanName="appointment-virtualmeeting.addVirtualMeetingTask"
            p:configBeanName="appointment-virtualmeeting.addVirtualMeetingTaskConfig"
            p:configRequired="true"
            p:formTaskRequired="false"
            p:taskForAutomaticAction="true" />

      <!-- TODO: DeleteVirtualMeetingTask is disabled until room deletion is supported by all providers
      <bean id="appointment-virtualmeeting.deleteVirtualMeetingTaskType"
            class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
            p:key="deleteVirtualMeetingTask"
            p:titleI18nKey="module.appointment.virtualmeeting.task.deleteVirtualMeeting.title"
            p:beanName="appointment-virtualmeeting.deleteVirtualMeetingTask"
            p:configRequired="false"
            p:formTaskRequired="false"
            p:taskForAutomaticAction="true" />
      -->

      <!-- ======================== Tasks ======================== -->

      <bean id="appointment-virtualmeeting.addVirtualMeetingTask"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.service.AddVirtualMeetingTask"
            scope="prototype" />

      <!-- TODO: DeleteVirtualMeetingTask is disabled until room deletion is supported by all providers
      <bean id="appointment-virtualmeeting.deleteVirtualMeetingTask"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.service.DeleteVirtualMeetingTask"
            scope="prototype" />
      -->

      <!-- ======================== Task Components ======================== -->

      <bean id="appointment-virtualmeeting.addVirtualMeetingTaskComponent"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.web.AddVirtualMeetingTaskComponent"
            p:taskType-ref="appointment-virtualmeeting.addVirtualMeetingTaskType"
            p:taskConfigService-ref="appointment-virtualmeeting.addVirtualMeetingTaskService" />

      <!-- TODO: DeleteVirtualMeetingTask is disabled until room deletion is supported by all providers
      <bean id="appointment-virtualmeeting.deleteVirtualMeetingTaskComponent"
            class="fr.paris.lutece.plugins.appointment.modules.virtualmeeting.web.DeleteVirtualMeetingTaskComponent"
            p:taskType-ref="appointment-virtualmeeting.deleteVirtualMeetingTaskType" />
      -->

      

</beans>
